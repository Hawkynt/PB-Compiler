' Control flow: FOR/DO/IF/SELECT/GOSUB/GOTO.
DIM i AS INTEGER
FOR i = 1 TO 5
  PRINT "I="; i
NEXT i
i = 0
DO WHILE i < 3
  INCR i
LOOP
PRINT "DO"; i
i = 10
IF i > 5 THEN PRINT "GT" ELSE PRINT "LE"
SELECT CASE i
  CASE 1 TO 9
    PRINT "1-9"
  CASE 10
    PRINT "TEN"
  CASE ELSE
    PRINT "OTHER"
END SELECT
GOSUB sr
PRINT "AFTER"
GOTO fin
sr:
PRINT "SUB"
RETURN
fin:
END
