' Sequential file I/O: write, append, read back, EOF, FREEFILE, KILL.
DIM f AS INTEGER, n AS INTEGER
DIM s AS STRING
KILL "OUT.TXT"
f = FREEFILE
PRINT f
OPEN "OUT.TXT" FOR OUTPUT AS #f
PRINT #f, "LINE ONE"
PRINT #f, "VALUE ="; 42
CLOSE #f
OPEN "OUT.TXT" FOR APPEND AS #1
PRINT #1, "APPENDED"
CLOSE #1
OPEN "OUT.TXT" FOR INPUT AS #2
n = 0
DO WHILE EOF(2) = 0
  LINE INPUT #2, s
  n = n + 1
  PRINT n; ": "; s
LOOP
CLOSE
KILL "OUT.TXT"
PRINT "DONE"
END
