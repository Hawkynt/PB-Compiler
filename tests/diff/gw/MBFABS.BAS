10 OPEN "RESULT.TXT" FOR OUTPUT AS #1
20 X!=-1D-38:Y!=ABS(X!):P%=VARPTR(Y!):N%=3:GOSUB 500
30 X!=-3D-39:Y!=ABS(X!):P%=VARPTR(Y!):N%=3:GOSUB 500
