10 OPEN "RESULT.TXT" FOR OUTPUT AS #1
20 PRINT #1, 1; -1; 32767; -32768
30 PRINT #1, 2/3; 1/3
40 A! = 1
50 PRINT #1, A!/3
60 B# = 1
70 PRINT #1, B#/3
80 PRINT #1, 1E6; 1E7; 1E8; 1E-1; 1E-7
90 PRINT #1, 1D15; 1D16; 123456.789; 1.23456789012345678
100 PRINT #1, VAL("1e3"); VAL("&HFF"); VAL("&HFFFF"); VAL("&O777")
110 PRINT #1, STR$(2/3); STR$(1E7)
120 PRINT #1, 7 MOD 3; -7 MOD 3; 7 \ 2
130 PRINT #1, 2 ^ 0.5; 2 ^ 2
140 PRINT #1, HEX$(255); " "; HEX$(-1); " "; OCT$(8)
150 PRINT #1, CINT(2.5); CINT(3.5); INT(-1.5); FIX(-1.5)
160 PRINT #1, SQR(2); EXP(1)
170 PRINT #1, "a", "b"
180 PRINT #1, TAB(10); "x"; SPC(3); "y"
190 F% = 32767
200 PRINT #1, F% + 1
210 FOR I% = 1 TO 5
220 PRINT #1, I%;
230 NEXT
240 PRINT #1, ""
250 CLOSE #1
260 SYSTEM
